# MongoDB Atlas Connection URI (keep real credentials in local .env, NEVER commit)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Primary Application Database
DATABASE_NAME=brandshield_dev

# Dedicated Test Database (MUST be distinct from DATABASE_NAME)
TEST_DATABASE_NAME=brandshield_test

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment: development, staging, production
ENVIRONMENT=development

# Server Port (Render sets PORT dynamically)
PORT=8000

# Authentication & JWT Configuration
# Generate a strong 32+ byte random secret for production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
